{
  "name": "hero_financ",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sync-contas": "mkdir -p public/contas && cp ../contas/*.ofx public/contas/ 2>/dev/null; node scripts/update-manifest.mjs",
    "predev": "npm run sync-contas",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0"
  }
}
